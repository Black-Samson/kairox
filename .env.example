# ─────────────────────────────────────────────────────────────────────────────
# Kairox — copy to .env.local and fill in. Everything is optional: with nothing
# set, Kairox runs in "Live Market + Sandbox Execution" mode and never crashes.
# NEVER guess contract addresses — paste them from HSKSwap / HashKey docs.
# ─────────────────────────────────────────────────────────────────────────────

# Network: mainnet (chainId 177, default) or testnet (chainId 133)
NEXT_PUBLIC_HSK_NETWORK=mainnet
# Optional server-side RPCs. The official RPC (mainnet.hsk.xyz / testnet.hsk.xyz) is built in.
# HSK_RPC_URL is tried first; HSK_RPC_FALLBACK after the official RPC.
HSK_RPC_URL=
HSK_RPC_FALLBACK=

# ── HSKSwap ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_HSKSWAP_VERSION=v3              # v3 | v2
NEXT_PUBLIC_HSKSWAP_ROUTER_ADDRESS=         # v3: SwapRouter02 (or SwapRouter) · v2: Router02
NEXT_PUBLIC_HSKSWAP_QUOTER_ADDRESS=         # v3: QuoterV2 · v2: Factory
NEXT_PUBLIC_HSKSWAP_FEE_TIER=3000           # v3 pool fee: 500 | 3000 | 10000
NEXT_PUBLIC_HSKSWAP_V3_ROUTER_TYPE=swaprouter02   # swaprouter02 | swaprouter (struct with deadline)

# ── Tokens ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHSK_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# ── KairoxVault (deploy with: cd contracts && npm run deploy:mainnet) ───────
NEXT_PUBLIC_KAIROX_VAULT_ADDRESS=
# Server-only. The agent's hot wallet = the vault OPERATOR. It can trade within
# the vault's limits but can never withdraw. Do NOT reuse your owner wallet.
AGENT_PRIVATE_KEY=

# ── Auth (Privy v3) ──────────────────────────────────────────────────────────
# Without it, wallet connect + Judge Sandbox still work; Google/X/email/passkey are disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Copilot LLM (any OpenAI-compatible endpoint, or Anthropic) ───────────────
# Without a key the copilot uses the deterministic rule parser.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# ── Reference price ──────────────────────────────────────────────────────────
REFERENCE_SOURCES=gate,mexc,coingecko
# Set to 1 to force the synthetic market (offline demos)
REFERENCE_OFFLINE=0
